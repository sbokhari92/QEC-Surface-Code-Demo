from itertools import combinations
import math
import random
from typing import Dict, Iterable, List, Sequence, Tuple

Coord = Tuple[int, int]


# -----------------------------------------------------------------------------
# Part 1: Stabilizer / Clifford circuit simulator
# -----------------------------------------------------------------------------

class PauliString:
    """Binary symplectic representation of an n-qubit Pauli string.

    For each qubit:
        I -> x=0, z=0
        X -> x=1, z=0
        Z -> x=0, z=1
        Y -> x=1, z=1

    This class supports Clifford conjugation by H, S, and CNOT. It is enough to
    demonstrate how stabilizer generators transform under Clifford circuits.
    """

    def __init__(self, x: Sequence[int], z: Sequence[int], phase: int = 0):
        if len(x) != len(z):
            raise ValueError("x and z must have the same length")
        self.x = [int(v) & 1 for v in x]
        self.z = [int(v) & 1 for v in z]
        self.phase = phase % 2  # track only +/- sign for clean display

    @classmethod
    def single(cls, n: int, qubit: int, pauli: str) -> "PauliString":
        x = [0] * n
        z = [0] * n
        p = pauli.upper()
        if p == "X":
            x[qubit] = 1
        elif p == "Z":
            z[qubit] = 1
        elif p == "Y":
            x[qubit] = 1
            z[qubit] = 1
        elif p == "I":
            pass
        else:
            raise ValueError("pauli must be I, X, Y, or Z")
        return cls(x, z)

    def copy(self) -> "PauliString":
        return PauliString(self.x[:], self.z[:], self.phase)

    def h(self, q: int) -> None:
        # H X H = Z, H Z H = X, H Y H = -Y
        if self.x[q] and self.z[q]:
            self.phase ^= 1
        self.x[q], self.z[q] = self.z[q], self.x[q]

    def s(self, q: int) -> None:
        # S X S† = Y, S Y S† = -X, S Z S† = Z
        if self.x[q] and self.z[q]:
            self.phase ^= 1
        self.z[q] ^= self.x[q]

    def cnot(self, control: int, target: int) -> None:
        # Clifford conjugation rules:
        # X_c -> X_c X_t
        # Z_t -> Z_c Z_t
        self.x[target] ^= self.x[control]
        self.z[control] ^= self.z[target]

    def anticommutes_with(self, other: "PauliString") -> bool:
        value = 0
        for x1, z1, x2, z2 in zip(self.x, self.z, other.x, other.z):
            value ^= (x1 & z2) ^ (z1 & x2)
        return bool(value)

    def __str__(self) -> str:
        chars = []
        for x, z in zip(self.x, self.z):
            if x == 0 and z == 0:
                chars.append("I")
            elif x == 1 and z == 0:
                chars.append("X")
            elif x == 0 and z == 1:
                chars.append("Z")
            else:
                chars.append("Y")
        sign = "-" if self.phase else "+"
        return sign + "".join(chars)


class StabilizerCircuitSimulator:
    """Simple stabilizer-state simulator for Clifford gate demonstrations.

    Starts in |0...0>, whose stabilizer group is generated by Z_i on every qubit.
    The simulator updates the stabilizer generators under Clifford gates.
    """

    def __init__(self, n_qubits: int):
        self.n = n_qubits
        self.generators = [PauliString.single(n_qubits, q, "Z") for q in range(n_qubits)]

    def h(self, q: int) -> None:
        for g in self.generators:
            g.h(q)

    def s(self, q: int) -> None:
        for g in self.generators:
            g.s(q)

    def cnot(self, control: int, target: int) -> None:
        for g in self.generators:
            g.cnot(control, target)

    def measure_pauli_commutation(self, operator: PauliString) -> str:
        """Return whether a Pauli measurement is deterministic or random.

        In stabilizer theory, measuring an operator that commutes with all current
        stabilizer generators is deterministic up to the stabilizer group sign.
        If it anticommutes with any generator, the result is random and the state
        would update. This demo reports the condition without state collapse.
        """
        if any(g.anticommutes_with(operator) for g in self.generators):
            return "random measurement outcome; state update required"
        return "commutes with stabilizer generators; deterministic in this toy model"

    def stabilizers(self) -> List[str]:
        return [str(g) for g in self.generators]


# -----------------------------------------------------------------------------
# Part 2: Surface-code toy simulator and syndrome extraction
# -----------------------------------------------------------------------------

@dataclass(frozen=True)
class StabilizerCheck:
    kind: str  # "X" or "Z"
    location: Coord
    data_qubits: Tuple[Coord, ...]


class RotatedSurfaceCodeToy:
    """Toy rotated-surface-code layout.

    Data qubits live on a d x d square grid. Stabilizer checks live on plaquettes
    between data qubits. The checkerboard assignment alternates X and Z checks.

    This is a simplified educational layout. Real rotated surface codes include
    careful boundary checks and repeated noisy syndrome measurements.
    """

    def __init__(self, distance: int):
        if distance < 3 or distance % 2 == 0:
            raise ValueError("Use an odd code distance d >= 3")
        self.d = distance
        self.data_qubits: List[Coord] = [(r, c) for r in range(distance) for c in range(distance)]
        self.x_checks: List[StabilizerCheck] = []
        self.z_checks: List[StabilizerCheck] = []
        self._build_checks()

    def _build_checks(self) -> None:
        for r in range(self.d - 1):
            for c in range(self.d - 1):
                neighbors = ((r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1))
                if (r + c) % 2 == 0:
                    self.x_checks.append(StabilizerCheck("X", (r, c), neighbors))
                else:
                    self.z_checks.append(StabilizerCheck("Z", (r, c), neighbors))

    def sample_z_errors(self, physical_error_rate: float, rng: random.Random) -> Dict[Coord, int]:
        """Sample independent Z errors on data qubits.

        Z errors anticommute with X checks, so the X-check syndrome detects them.
        """
        return {q: int(rng.random() < physical_error_rate) for q in self.data_qubits}

    def x_syndrome_from_z_errors(self, z_errors: Dict[Coord, int]) -> Dict[Coord, int]:
        syndrome = {}
        for check in self.x_checks:
            parity = 0
            for q in check.data_qubits:
                parity ^= z_errors.get(q, 0)
            syndrome[check.location] = parity
        return syndrome

    def syndrome_defects(self, syndrome: Dict[Coord, int]) -> List[Coord]:
        return [loc for loc, value in syndrome.items() if value == 1]

    def greedy_decode_z_errors(self, defects: List[Coord]) -> Dict[Coord, int]:
        """Very simple syndrome decoder.

        A production decoder would use minimum-weight perfect matching or union-find.
        This toy decoder greedily pairs nearby defects and applies a correction path
        between them. It is intentionally readable for a portfolio project.
        """
        remaining = defects[:]
        correction = {q: 0 for q in self.data_qubits}

        while len(remaining) >= 2:
            a = remaining.pop(0)
            b = min(remaining, key=lambda x: manhattan(a, x))
            remaining.remove(b)
            for q in self._path_between_checks(a, b):
                if q in correction:
                    correction[q] ^= 1

        # If there is an unpaired defect, connect it to the nearest boundary.
        if remaining:
            a = remaining.pop()
            for q in self._path_to_boundary(a):
                if q in correction:
                    correction[q] ^= 1

        return correction

    def _path_between_checks(self, a: Coord, b: Coord) -> List[Coord]:
        """Map a path between check coordinates to nearby data qubits."""
        r, c = a
        rb, cb = b
        path = []
        while r != rb:
            step = 1 if rb > r else -1
            path.append((max(0, min(self.d - 1, r + (step > 0))), max(0, min(self.d - 1, c))))
            r += step
        while c != cb:
            step = 1 if cb > c else -1
            path.append((max(0, min(self.d - 1, r)), max(0, min(self.d - 1, c + (step > 0)))))
            c += step
        return path

    def _path_to_boundary(self, a: Coord) -> List[Coord]:
        r, c = a
        # Choose nearest vertical boundary for this toy model.
        if c < self.d / 2:
            return [(r, cc) for cc in range(c + 1)]
        return [(r, cc) for cc in range(c, self.d)]

    def has_logical_z_failure(self, residual_z: Dict[Coord, int]) -> bool:
        """Toy logical-failure test.

        We flag failure if any full column has odd residual Z parity. In a real
        surface code, logical operators and boundaries must be defined precisely.
        """
        for c in range(self.d):
            parity = 0
            for r in range(self.d):
                parity ^= residual_z.get((r, c), 0)
            if parity == 1:
                return True
        return False

    def run_single_round(self, p: float, rng: random.Random) -> Dict[str, object]:
        errors = self.sample_z_errors(p, rng)
        syndrome = self.x_syndrome_from_z_errors(errors)
        defects = self.syndrome_defects(syndrome)
        correction = self.greedy_decode_z_errors(defects)
        residual = {q: errors[q] ^ correction[q] for q in self.data_qubits}
        return {
            "errors": errors,
            "syndrome": syndrome,
            "defects": defects,
            "correction": correction,
            "residual": residual,
            "logical_failure": self.has_logical_z_failure(residual),
        }

    def monte_carlo_logical_error_rate(self, p: float, shots: int, seed: int = 7) -> float:
        rng = random.Random(seed)
        failures = 0
        for _ in range(shots):
            result = self.run_single_round(p, rng)
            failures += int(result["logical_failure"])
        return failures / shots

    def print_layout_summary(self) -> None:
        print(f"Rotated surface-code toy model, distance d={self.d}")
        print(f"Data qubits: {len(self.data_qubits)}")
        print(f"X stabilizer checks: {len(self.x_checks)}")
        print(f"Z stabilizer checks: {len(self.z_checks)}")


# -----------------------------------------------------------------------------
# Part 3: Quantum resource estimator
# -----------------------------------------------------------------------------

@dataclass
class ResourceEstimate:
    code_distance: int
    physical_data_qubits_per_logical: int
    syndrome_qubits_per_logical: int
    total_physical_qubits_per_logical: int
    qec_cycle_time_ns: float
    logical_error_per_cycle: float
    physical_error_rate: float


def estimate_logical_error_rate(
    physical_error_rate: float,
    code_distance: int,
    threshold: float = 1e-2,
    prefactor: float = 0.1,
) -> float:
    """Back-of-the-envelope logical error estimate.

    Common surface-code scaling heuristic:
        p_L ≈ A * (p / p_threshold)^((d + 1) / 2)

    This is not a substitute for a full device model, but it is useful for
    resource-estimation intuition.
    """
    exponent = (code_distance + 1) / 2
    return prefactor * (physical_error_rate / threshold) ** exponent


def estimate_surface_code_resources(
    physical_error_rate: float,
    code_distance: int,
    logical_qubits: int = 1,
    qec_cycle_time_ns: float = 1000.0,
) -> ResourceEstimate:
    data = code_distance**2
    syndrome = code_distance**2 - 1
    total = logical_qubits * (data + syndrome)
    p_logical = estimate_logical_error_rate(physical_error_rate, code_distance)
    return ResourceEstimate(
        code_distance=code_distance,
        physical_data_qubits_per_logical=data,
        syndrome_qubits_per_logical=syndrome,
        total_physical_qubits_per_logical=total,
        qec_cycle_time_ns=qec_cycle_time_ns,
        logical_error_per_cycle=p_logical,
        physical_error_rate=physical_error_rate,
    )


def choose_code_distance(
    physical_error_rate: float,
    target_logical_error: float,
    max_distance: int = 51,
) -> ResourceEstimate:
    for d in range(3, max_distance + 1, 2):
        estimate = estimate_surface_code_resources(physical_error_rate, d)
        if estimate.logical_error_per_cycle <= target_logical_error:
            return estimate
    raise ValueError("Target logical error was not reached within max_distance")


# -----------------------------------------------------------------------------
# Helpers and demos
# -----------------------------------------------------------------------------

def manhattan(a: Coord, b: Coord) -> int:
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def format_error_grid(values: Dict[Coord, int], d: int, one: str = "1", zero: str = ".") -> str:
    rows = []
    for r in range(d):
        rows.append(" ".join(one if values.get((r, c), 0) else zero for c in range(d)))
    return "\n".join(rows)


def demo_stabilizer_simulator() -> None:
    print("\n=== Stabilizer / Clifford simulator demo ===")
    sim = StabilizerCircuitSimulator(2)
    print("Initial |00> stabilizers:", sim.stabilizers())

    # Create a Bell state using H on qubit 0 and CNOT 0 -> 1.
    sim.h(0)
    sim.cnot(0, 1)
    print("After H(0), CNOT(0,1), Bell-state stabilizers:", sim.stabilizers())

    xx = PauliString([1, 1], [0, 0])
    zi = PauliString([0, 0], [1, 0])
    print("Measure XX:", sim.measure_pauli_commutation(xx))
    print("Measure ZI:", sim.measure_pauli_commutation(zi))


def demo_surface_code() -> None:
    print("\n=== Surface-code toy simulator demo ===")
    code = RotatedSurfaceCodeToy(distance=5)
    code.print_layout_summary()

    result = code.run_single_round(p=0.03, rng=random.Random(2))
    print("\nSampled Z-error pattern on data qubits:")
    print(format_error_grid(result["errors"], code.d, one="Z"))

    print("\nSyndrome defects from X stabilizer checks:")
    defect_grid = {loc: 1 for loc in result["defects"]}
    print(format_error_grid(defect_grid, code.d - 1, one="*") )

    print("\nDecoder correction pattern:")
    print(format_error_grid(result["correction"], code.d, one="C"))

    print("\nResidual error after correction:")
    print(format_error_grid(result["residual"], code.d, one="R"))
    print("Logical failure?", result["logical_failure"])

    print("\nMonte Carlo logical-error estimate with toy decoder:")
    for p in [0.005, 0.01, 0.02, 0.03]:
        rate = code.monte_carlo_logical_error_rate(p=p, shots=500, seed=11)
        print(f"p={p:.3f} -> toy logical failure rate ≈ {rate:.3f}")


def demo_resource_estimator() -> None:
    print("\n=== Surface-code resource estimator demo ===")
    for d in [3, 5, 7, 9, 11]:
        est = estimate_surface_code_resources(physical_error_rate=1e-3, code_distance=d)
        print(
            f"d={d:2d} | data={est.physical_data_qubits_per_logical:4d} | "
            f"syndrome={est.syndrome_qubits_per_logical:4d} | "
            f"p_L/cycle≈{est.logical_error_per_cycle:.2e}"
        )

    target = 1e-9
    chosen = choose_code_distance(physical_error_rate=1e-3, target_logical_error=target)
    print(
        f"\nFor physical error p=1e-3 and target logical error {target:.0e}, "
        f"heuristic minimum distance is d={chosen.code_distance}."
    )


def main() -> None:
    demo_stabilizer_simulator()
    demo_surface_code()
    demo_resource_estimator()
if __name__ == "__main__":
    main()
